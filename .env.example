# Supabase — Python reads NEXT_PUBLIC_SUPABASE_URL or SUPABASE_URL
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Reducto — https://platform.reducto.ai
REDUCTO_API_KEY=your_reducto_key

# Ingestion: extract (schema JSON) vs parse (HTML tables → local column map).
# IMPORT_REDUCTO_MODE=extract
# IMPORT_REDUCTO_MODE=parse
# Or: python import_sales.py sales.pdf --parse --dry-run
#
# Excel (.xlsx / .xlsm): no Reducto — python import_sales.py sales.xlsx [--sheet Sheet1]
# CSV: python import_sales.py "sales.csv" [--dry-run]
# EXCEL_SHEET=Sheet1
# CSV_ENCODING=utf-8-sig

# Optional (milliseconds)
IMPORT_EXTRACT_TIMEOUT_MS=420000

# line_normalize — repair OCR outliers (carton Bleed, warehouse junk, doubled U/P).
# LINE_MAX_SANE_CTN=120
# LINE_SWAP_OCR_PACK_COLUMNS=1

# LINE_FACTORIZE_BOTH_MISSING_MIN_TQ=24
#
# LINE_MAX_SANE_LINE_AMOUNT_RMB=60000
# LINE_REINTERPRET_AS_AMOUNT_UP_MIN=30
# LINE_REINTERPRET_AS_AMOUNT_UP_MAX=20000
# LINE_REINTERPRET_BIG_QTY_THRESHOLD=1500
# LINE_REINTERPRET_MIN_UNIT_PRICE_FOR_BIG_QTY=120
# LINE_REINTERPRET_IMPLAUSIBLE_KG_PER_QTY=0.04

# Line items: **PDF-exact by default**
# document_totals still compares SUM(lines) vs PDF footer (totals_match).
#
# Match PDF footer CTN + T.QTY only (keeps T.QTY = CTN × QTY per row):
# FOOTER_ALIGN_FIT_CTN_QTY=1
#
# Legacy: force sums to footer by scaling every line (distorts display vs the sheet):
# FOOTER_ALIGN_PROPORTIONAL=1
#
# If proportional mode is on, you may also include total_quantity in the scale set:
# FOOTER_ALIGN_SCALE_TOTAL_QUANTITY=1
